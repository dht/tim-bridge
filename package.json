{
  "name": "tim-bridge-nextgen",
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src --ext js,json --exec node src/index.js",
    "watch": "npm run dev",
    "robotic": "node src/index.robotic.js",
    "robotic:test": "node src/index.robotic.test.js",
    "robotic:listen": "nodemon --watch src --ext js,json --ignore '**/node_modules/**' --ignore '**/venv/**' --ignore '**/.venv/**' --exec node src/index.robotic.js basePosition",
    "launcher:start-only": "node launcher/start-only-listener.js",
    "pi:sync": "nodemon --watch src --watch playground --ext js,json --ignore '**/node_modules/**' --ignore '**/venv/**' --ignore '**/.venv/**' --exec ./pi-rsync.sh",
    "build": "find src -type f -name \"*.js\" -print0 | xargs -0 -n1 node --check",
    "test": "echo \"Error: no test specified\" && exit 1",
    "web:serve": "ln -sfn ../cache web/cache && serve web -l 3000 -S",
    "test.button": "node src/test.button.js",
    "test.print": "node src/test.print.js"
  },
  "dependencies": {
    "@abandonware/noble": "1.9.2-26",
    "@firebase/app": "^0.14.7",
    "@firebase/firestore": "^4.10.0",
    "axios": "^1.13.4",
    "canvas": "^3.2.1",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "firebase-admin": "^12.7.0",
    "fs-extra": "^11.3.3",
    "internal-ip": "^8.0.1",
    "i2c-bus": "^5.2.3",
    "pca9685": "^5.0.0",
    "minimatch": "^10.2.0",
    "p-limit": "^7.2.0",
    "pigpio": "^3.3.1",
    "rpio": "^2.4.2",
    "tim-logger": "^0.0.40",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "serve": "^14.2.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
